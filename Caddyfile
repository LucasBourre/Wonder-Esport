# Caddy sert les pages du jeu et relaie /api (WebSocket compris) au serveur.
#
# SITE_ADDRESS :
#   « :80 » (défaut)            HTTP simple, pour un essai local ou derrière un
#                               autre proxy qui gère déjà le HTTPS ;
#   « openeleven.exemple.fr »   Caddy obtient et renouvelle seul le certificat.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy server:3000
	}

	handle {
		root * /srv

		# L'application assemblée porte une empreinte dans son nom : un fichier
		# donné ne change jamais, le navigateur peut le garder indéfiniment.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# Les pages et le service worker, eux, doivent toujours être revérifiés :
		# ce sont eux qui annoncent une nouvelle version.
		@fresh path / *.html /sw.js /site.webmanifest
		header @fresh Cache-Control "no-cache"

		header X-Content-Type-Options "nosniff"
		header Referrer-Policy "strict-origin-when-cross-origin"

		file_server
	}
}
