# Configuration d'Open Eleven sous Docker. Copier en « .env », puis renseigner.

# Mot de passe de la base (interne aux conteneurs). Lettres et chiffres
# seulement : il est repris tel quel dans une adresse de connexion.
POSTGRES_PASSWORD=

# Adresse publique du jeu, telle que les joueurs la tapent, sans « / » final.
# Elle sert aux liens des e-mails et au contrôle d'origine des requêtes :
# si elle ne correspond pas à l'adresse réelle, la connexion au compte échoue.
PUBLIC_URL=http://localhost

# Ce que Caddy sert. « :80 » = HTTP simple (essai local, ou derrière un autre
# proxy). Un nom de domaine = HTTPS automatique (les ports 80 et 443 doivent
# alors être ouverts, et le domaine pointer sur cette machine).
SITE_ADDRESS=:80
# HTTP_PORT=80
# HTTPS_PORT=443

# Envoi d'e-mails (confirmation d'inscription, mot de passe oublié).
# Vide = pas d'e-mails : un compte est actif dès l'inscription, et le mot de
# passe oublié est indisponible.
# Exemple : smtps://utilisateur:motdepasse@smtp.exemple.fr:465
SMTP_URL=
MAIL_FROM=Open Eleven <no-reply@exemple.fr>
